<Application x:Class="slitherrrrr.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:slitherrrrr"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key = "BackgroundColor">#f7dfef</SolidColorBrush>
        <SolidColorBrush x:Key = "GridBackgroundColor">#eda8be</SolidColorBrush>
        <SolidColorBrush x:Key = "GridLineColor">#4F4867</SolidColorBrush>
        <SolidColorBrush x:Key = "TextColor">#ba0f81</SolidColorBrush>
        <SolidColorBrush x:Key = "OverlayColor">#7F000000</SolidColorBrush>
        <FontFamily x:Key = "MainFont">Assets/#Droid Sans Mono</FontFamily>
    </Application.Resources>
</Application>
